{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vercel's per-file TypeScript compiler needs explicit Fetch API types;
    // relying only on @types/node leaves Response without its members there.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // NestJS будує DI на метаданих декораторів; class-validator (§11) читає
    // design:type звідти ж.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // §12.3: після відсутнього baseUrl TS 6 не підхоплює @types автоматично —
    // перелічуємо явно. `jest` тут, бо цей конфіг охоплює і test/.
    "types": ["node", "jest"]

    // Налаштування емісії (outDir, rootDir) навмисно лише в tsconfig.build.json:
    // у TS 6 outDir без явного rootDir дає помилку TS5011, а ts-jest компілює
    // файли поодинці, тож «спільною текою» стає тека конкретного тесту.
  },
  // prisma/ і prisma.config.ts входять сюди, а не в tsconfig.build.json: вони не
  // компілюються в dist (їх виконує tsx / Prisma CLI), але мають покриватися
  // `tsc --noEmit` і type-aware правилами ESLint нарівно з рештою коду.
  "include": ["src/**/*", "test/**/*", "prisma/**/*", "prisma.config.ts"]
}
