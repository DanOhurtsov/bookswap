// Модель даних §4 специфікації.
//
// Схема заводиться ВСЯ одразу (§14, етап 1) — включно з `Loan` і сповіщеннями,
// код під які пишеться на етапах 2–3. Ключове, що не спрощується:
// Work → Translation → Edition → Copy, і позичається завжди `Copy`.

// §4.1 писався під Prisma 6 і прямо просить звірити блок із фактичним синтаксисом
// встановленої версії. Тут Prisma 7.9, і вона розійшлася з текстом ТЗ у трьох місцях:
//
//   1. `prisma-client-js` deprecated → `prisma-client`, і `output` тепер обов'язковий.
//      Генерований клієнт лежить у `src/`, тож його компілює звичайний `tsc`.
//   2. `binaryTargets` більше не існує: Rust-движок прибрано, клієнт — TypeScript
//      плюс WASM query compiler. Вимога §4.1 «ARM для Hetzner CAX» від цього не
//      зникає — вона виконується сама собою, бо нативних движків більше немає й
//      архітектура сервера ролі не грає.
//   3. `url` / `directUrl` / `extensions` пішли з `datasource`: URL живе в
//      `prisma.config.ts`, а розширення створюються сирим SQL у першій міграції
//      (§4.9 і так цього вимагає — Prisma не гарантує порядок відносно індексів).
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// §4.2 Користувачі
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  passwordHash  String
  displayName   String
  avatarUrl     String?
  bio           String?
  createdAt     DateTime @default(now())

  // Видимість
  libraryVisibility Visibility @default(FRIENDS)
  showHolderNames   Boolean    @default(true)

  // Канали сповіщень
  telegramChatId String? @unique

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  copiesOwned          Copy[]                   @relation("CopyOwner")
  copiesHeld           Copy[]                   @relation("CopyHolder")
  loansAsBorrower      Loan[]                   @relation("LoanBorrower")
  loansAsOwner         Loan[]                   @relation("LoanOwner")
  reviews              Review[]
  translationRatings   TranslationRating[]
  friendshipsA         Friendship[]             @relation("FriendA")
  friendshipsB         Friendship[]             @relation("FriendB")
  friendshipsBlocked   Friendship[]             @relation("FriendshipBlockedBy")
  wishlist             WishlistItem[]
  readingStatuses      WorkReadingStatus[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  productEvents        ProductEvent[]
  catalogRevisions     CatalogRevision[]
  libraryImports       LibraryImport[]
  libraryAddOperations LibraryAddOperation[]
  invitationsSent      Invitation[]
  invitationsAccepted  InvitationAcceptance[]
  externalBorrowers    ExternalBorrower[]
  loanEvents           LoanEvent[]

  @@index([displayName])
}

enum Visibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

// ---------------------------------------------------------------------------
// Сесії та одноразові токени (§6.1)
//
// Цих трьох моделей у §4 немає: розділ описує домен, а не механіку автентифікації.
// Вони заводяться тут як необхідна залежність §6.1 — «session cookie, не JWT»
// без серверного сховища сесій нездійсненне.
//
// Спільне для всіх трьох: у базі лежить SHA-256 від токена, а не сам токен.
// Дамп бази чи SQL-ін'єкція з читанням тоді не дають нічим скористатися. Швидкий
// геш тут доречний саме тому, що токен — це 256 біт із CSPRNG: перебирати нічого,
// на відміну від пароля користувача (див. password.service.ts).
// ---------------------------------------------------------------------------

/// Серверна сесія. Кукі несе сирий токен, сюди потрапляє лише його геш.
model Session {
  id String @id @default(cuid())

  /// SHA-256 (hex) від токена з кукі. Унікальний — за ним і йде пошук.
  tokenHash String @unique
  userId    String

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  /// Проставляється при logout. Рядок не видаляється одразу, щоб відкликання
  /// лишалося видимим до чистки простроченого.
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Одноразовий токен підтвердження пошти (§6.1).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  /// Одноразовість: перевіряється й проставляється однією атомарною операцією.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Одноразовий токен скидання пароля (§6.1).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// §4.3 Дружба
// ---------------------------------------------------------------------------

/// Один рядок на пару. Інваріант §5.3.5: `userAId < userBId` лексикографічно —
/// це прибирає OR-умови з кожної перевірки «чи ми друзі».
model Friendship {
  id      String           @id @default(cuid())
  userAId String
  userBId String
  status  FriendshipStatus @default(PENDING)

  /// §4.3: НЕ виводиться з A/B. Порядок задає сортування id, а не те, хто ініціював.
  requestedById String

  /// Хто ініціював BLOCKED. Поля §4.3 не має — це свідоме доповнення: без нього
  /// статус симетричний, тобто не відрізнити «я заблокував» від «мене заблокували»,
  /// а отже нікому не можна дати право зняти блок. `requestedById` для цього не
  /// годиться: він означає ініціатора ЗАПИТУ, і §4.3 прямо вимагає тримати його
  /// окремо.
  ///
  /// На відміну від `requestedById`, тут є справжній зовнішній ключ: від цього
  /// поля залежить ПРАВО (знімати блок може лише той, хто в ньому записаний), а
  /// право не можна тримати на рядку, який БД не перевіряє. Решту — що значення
  /// заповнене саме тоді, коли статус BLOCKED, і що це один з учасників пари —
  /// тримає CHECK `friendship_block_author_valid`.
  blockedById String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  userA User @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  blockedBy User? @relation("FriendshipBlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// ---------------------------------------------------------------------------
// §4.4 Каталог
// ---------------------------------------------------------------------------

model Author {
  id        String  @id @default(cuid())
  name      String
  /// lower + unaccent, для пошуку — дзеркало `Work.titleNorm`.
  ///
  /// ВІДХИЛЕННЯ ВІД §4.4: цієї колонки в специфікації немає. Без неї fuzzy-пошук
  /// по автору не працює, бо `similarity()` регістрозалежна: «ґреґорі» проти
  /// «Ґреґорі Робертс» дає майже нуль спільних триграм. Заповнюється тією самою
  /// SQL-функцією `bookswap_norm`, що й `titleNorm`, тож нормалізація лишається
  /// однією на весь каталог.
  nameNorm  String
  nameLatin String?

  works WorkAuthor[]

  @@index([name])
  @@index([nameNorm])
  // §4.9: GIN-індекс для fuzzy-пошуку (§6.3, крок 2). `pg_trgm` створюється сирим
  // SQL на початку першої міграції — інакше на чистій базі CREATE INDEX упаде.
  @@index([nameNorm(ops: raw("gin_trgm_ops"))], map: "author_name_trgm_idx", type: Gin)
}

model WorkAuthor {
  workId   String
  authorId String
  role     AuthorRole @default(AUTHOR)

  /// Stage 8e-1, R10a: manual order within `Work.authors`. Belongs to the link,
  /// not to `Author` — the same person keeps a separate position per role. Forms
  /// a gapless `0, 1, 2, …` sequence per `workId`; identity of the link stays the
  /// pair (`authorId`, `role`), unaffected by reordering.
  ///
  position Int

  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([workId, authorId, role])
}

enum AuthorRole {
  AUTHOR
  CO_AUTHOR
  EDITOR
  ILLUSTRATOR
}

model Work {
  id           String   @id @default(cuid())
  title        String
  /// lower + unaccent, для пошуку
  titleNorm    String
  /// ISO 639-1. `NULL` — мова оригіналу невідома (зовнішній чи ручний запис без неї); її не вигадують.
  origLang     String?
  firstPubYear Int?
  description  String?
  createdById  String
  createdAt    DateTime @default(now())

  /// Stage 8e-1, R9: optimistic concurrency for `PATCH /works/:id`. Bumped by
  /// the conditional update; a stale `expectedRevision` gets `409
  /// CATALOG_REVISION_CONFLICT` instead of a silent overwrite.
  revision Int @default(1)

  /// §6.3, мердж дублікатів: старий запис не видаляється, інакше вмирають зовнішні посилання.
  mergedIntoId String?
  mergedInto   Work?   @relation("WorkMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Work[]  @relation("WorkMerge")

  authors         WorkAuthor[]
  editions        Edition[]
  translations    Translation[]
  reviews         Review[]            @relation("ReviewWork")
  wishlistedBy    WishlistItem[]
  readingStatuses WorkReadingStatus[]

  /// Зворотний бік `Review.archivedByMergeSource` (R5). Іменований зв'язок потрібен
  /// суто тому, що між `Review` і `Work` їх стало два — сам по собі цей список
  /// нікому не читається.
  reviewsArchivedByMerge Review[] @relation("ReviewArchivedByMerge")

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  @@index([titleNorm])
  @@index([mergedIntoId])
  @@index([titleNorm(ops: raw("gin_trgm_ops"))], map: "work_title_trgm_idx", type: Gin)
}

model Translation {
  id         String @id @default(cuid())
  workId     String
  translator String
  lang       String
  /// §10.3: з якої мови перекладали — найсильніший наявний сигнал при cold start.
  sourceLang String
  year       Int?

  isAbridged Boolean @default(false)
  hasNotes   Boolean @default(false)
  notes      String?

  /// Stage 8e-1, R9/R8: needed for `PATCH /translations/:id` ownership (R8) —
  /// `Translation` had no creator at all before this. No Prisma relation, same
  /// as `Work.createdById`/`Edition.createdById` above: a plain scalar, not
  /// enforced referential integrity.
  ///
  createdById String
  /// Existing rows get migration time, not an invented historical date (CLAUDE.md).
  createdAt   DateTime @default(now())

  /// Stage 8e-1, R9: see `Work.revision`.
  revision Int @default(1)

  work     Work                @relation(fields: [workId], references: [id], onDelete: Cascade)
  editions Edition[]
  ratings  TranslationRating[]

  /// §10.2: байєсівський ранг. Перераховується разом зі зміною TranslationRating.
  score       Float @default(0)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  @@index([workId, lang])
  @@index([createdById])
}

model Edition {
  id            String         @id @default(cuid())
  workId        String
  /// Зв'язок з конкретним перекладом. `NULL` НЕ означає «оригінал»: що відомо про текст, каже `textKind`.
  translationId String?
  publisher     String?
  year          Int?
  isbn13        String?        @unique
  pageCount     Int?
  coverUrl      String?
  /// `NULL` — формат невідомий: «м'яку палітурку» ніхто не вгадує (docs/plan/fast-book-add.md, §4).
  format        EditionFormat?
  createdById   String
  createdAt     DateTime       @default(now())

  /// Що відомо про текст видання. Обов'язкове: легасі-рядки отримали значення зі старої семантики (backfill C2).
  textKind EditionTextKind
  /// Мова ЦЬОГО видання (ISO 639-1); `NULL` — невідома. Не доводить мови оригіналу.
  lang     String?

  /// Stage 8e-1, R9: see `Work.revision`.
  revision Int @default(1)

  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  translation Translation? @relation(fields: [translationId], references: [id])
  copies      Copy[]

  /// Точні зовнішні ідентифікатори цього видання (docs/plan/fast-book-add.md, §5.3).
  externalReferences EditionExternalReference[]

  @@index([workId])
  @@index([translationId])
}

/// Звідки взято видання: підтверджене джерелом зіставлення «зовнішній запис → наше видання». Це локальна довідка,
/// а не залежність: життєздатність книжки від провайдера не залежить. Дозволяє показати той самий стан кнопки для
/// різних представлень видання й не звертатися до мережі, коли видання вже відоме.
///
/// Запис створюється лише з відповіді самого джерела (не зі слів клієнта) і ніколи не переприв'язується.
model EditionExternalReference {
  id         String             @id @default(cuid())
  source     ExternalBookSource
  externalId String
  editionId  String
  createdAt  DateTime           @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([editionId])
}

enum ExternalBookSource {
  OPEN_LIBRARY
  GOOGLE_BOOKS
  ISBNDB
}

enum EditionFormat {
  HARDCOVER
  PAPERBACK
  POCKET
}

/// Швидке додавання (docs/plan/fast-book-add.md, §4): що відомо про текст видання.
enum EditionTextKind {
  ORIGINAL
  TRANSLATION
  UNKNOWN
}

enum CatalogEntityType {
  WORK
  TRANSLATION
  EDITION
}

/// Stage 8e-1, R9: immutable audit trail for `PATCH /works/:id`,
/// `/translations/:id`, `/editions/:id` (write path lands in 8e-2 — this model
/// only reserves the storage and its shared contracts).
///
/// No FK to the catalog entity on purpose: `entityId` must outlive a future
/// merge of the `Work`/`Translation`/`Edition` it once named (§6.3 — a merged
/// `Work` is never deleted, but a `Translation`/`Edition` row can still move to
/// a different `workId`), and a row here must never block or cascade from that.
/// `actor` is the opposite case — nullable with `SetNull` — because deleting the
/// acting `User` must not erase or corrupt an already-written history row.
model CatalogRevision {
  id         String            @id @default(cuid())
  entityType CatalogEntityType
  entityId   String

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Full snapshots of the entity's editable metadata (packages/shared
  /// `catalogRevisionSnapshotSchemas`) — for `Work`, author links and their
  /// order included. Not the public read response: no derived permissions or
  /// rating aggregates.
  before Json
  after  Json

  fromRevision Int
  toRevision   Int

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

/// docs/plan/stage-7.md, R3: кеш відповідей зовнішнього ISBN-провайдера (§6.3
/// «автозаповнення форми»). `payload` — уже нормалізована форма (див.
/// `@bookswap/shared`), не сирий Open Library JSON, тож повторне читання з
/// кешу не вимагає повторної нормалізації.
///
/// TTL (30 днів) рахує застосунок від `fetchedAt`, не Postgres: прострочений
/// рядок нікуди не зникає сам, а просто ігнорується й перезаписується
/// наступним успішним зовнішнім запитом.
model ExternalBookLookup {
  isbn      String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// §4.5 Примірники
// ---------------------------------------------------------------------------

/// §3: кількість примірників — це COUNT рядків `Copy`, а не поле `quantity`.
/// Поле ламається щойно один примірник позичений, а другий удома.
model Copy {
  id        String @id @default(cuid())
  editionId String
  ownerId   String

  /// Хто фізично тримає книгу зараз. Дорівнює ownerId, коли книга вдома (інваріант §5.3.2).
  /// Stage 10 (T1-a): NULL, коли книга в гостя (`heldByContactId`) або тримач стерто за D3.
  /// Рядки Етапу 10a ще ніколи не мають NULL — гостьових записів немає.
  currentHolderId String?
  /// Stage 10 (D1): контакт-гість, що тримає книгу. Взаємовиключне з `currentHolderId`.
  heldByContactId String?
  /// Stage 10: «більше не у власності» (архів, 10c). NULL = активний примірник.
  archivedAt      DateTime?

  status     CopyStatus @default(AVAILABLE)
  /// §4.5: ортогонально до status. Прихована книга може бути одночасно позиченою.
  visibility Visibility @default(FRIENDS)
  condition  Condition  @default(GOOD)
  note       String?
  acquiredAt DateTime?
  createdAt  DateTime   @default(now())

  edition       Edition           @relation(fields: [editionId], references: [id])
  owner         User              @relation("CopyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  currentHolder User?             @relation("CopyHolder", fields: [currentHolderId], references: [id], onDelete: Restrict)
  heldByContact ExternalBorrower? @relation("CopyHeldByContact", fields: [heldByContactId], references: [id], onDelete: SetNull)
  loans         Loan[]

  addOperations LibraryAddOperation[]

  @@index([ownerId, status])
  @@index([currentHolderId])
  @@index([heldByContactId])
  @@index([editionId])
}

/// Швидке додавання (docs/plan/fast-book-add.md, §5): що саме робить `POST /me/library/quick-add`.
enum LibraryAddTargetKind {
  EXISTING_EDITION
  EXTERNAL_EDITION
  MANUAL
}

/// Серверна ідемпотентність швидкого додавання: один рядок на (користувач, `operationId`).
///
/// Рядок і `Copy` створюються в одній транзакції, тож повтор того самого запиту повертає вже створений
/// примірник, а не додає новий фізичний том. `requestHash` — sha256 нормалізованого запиту без
/// `operationId`: той самий ключ з іншим вмістом — конфлікт. Приватна нотатка тут НЕ зберігається в
/// явному вигляді (лише всередині хешу).
///
/// `copyId` — `SetNull`: видалений примірник лишає запис про виконану операцію, а його повтор не
/// відновлює `Copy` (`LIBRARY_ADD_RESULT_REMOVED`). `editionId` — звичайний скаляр без FK, як
/// `CatalogRevision.entityId`: каталожний рядок не повинен блокувати чи каскадувати цей журнал.
model LibraryAddOperation {
  id          String               @id @default(cuid())
  userId      String
  operationId String
  requestHash String
  targetKind  LibraryAddTargetKind
  editionId   String
  copyId      String?
  createdAt   DateTime             @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  copy Copy? @relation(fields: [copyId], references: [id], onDelete: SetNull)

  @@unique([userId, operationId])
  @@index([copyId])
  @@index([targetKind, createdAt])
}

enum CopyStatus {
  /// вдома, вільна
  AVAILABLE
  /// запит підтверджено, з рук у руки ще не передано
  RESERVED
  /// фізично в позичальника
  LENT_OUT
  /// власник тимчасово не дає
  UNAVAILABLE
}

enum Condition {
  NEW
  GOOD
  WORN
  DAMAGED
}

// ---------------------------------------------------------------------------
// §4.6 Позичання
// ---------------------------------------------------------------------------

/// Ця таблиця одночасно є історією (§6.6). Окремої `CopyHistory` немає.
model Loan {
  id         String     @id @default(cuid())
  copyId     String
  /// денормалізовано з Copy на момент створення
  ownerId    String
  /// Stage 10: NULL лише для гостьових позик (`borrowerKind = GUEST`).
  borrowerId String?
  status     LoanStatus @default(REQUESTED)

  /// Stage 10 (T1): REGISTERED — `borrowerId`; GUEST — `borrowerContactId` (NULL після D3-чистки).
  borrowerKind      BorrowerKind @default(REGISTERED)
  borrowerContactId String?
  origin            LoanOrigin   @default(REQUESTED)
  /// Stage 10: коли запис створено. Для наявних рядків = `requestedAt`.
  createdAt         DateTime     @default(now())

  message      String?
  responseNote String?

  /// Stage 10 (T2): NULL для записаних власником позик (`origin ≠ REQUESTED`) — запиту не було.
  /// DEFAULT `now()` збережено свідомо, щоб код попереднього релізу не писав NULL під час rollout.
  requestedAt DateTime? @default(now())
  respondedAt DateTime?
  handedAt    DateTime?
  dueAt       DateTime?
  returnedAt  DateTime?

  copy              Copy                   @relation(fields: [copyId], references: [id], onDelete: Restrict)
  owner             User                   @relation("LoanOwner", fields: [ownerId], references: [id])
  borrower          User?                  @relation("LoanBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  borrowerContact   ExternalBorrower?      @relation("LoanBorrowerContact", fields: [borrowerContactId], references: [id], onDelete: SetNull)
  events            LoanEvent[]
  /// Stage 10 (10i.1): є лише в позик, створених через запит гостьового підтвердження.
  guestConfirmation GuestLoanConfirmation?

  @@index([copyId, status])
  @@index([borrowerContactId])
  @@index([borrowerId, status])
  @@index([ownerId, status])
}

/// §5.2: `OVERDUE` тут немає навмисно. Прострочення виводиться як
/// `status = HANDED_OVER AND dueAt < now()`; окремий статус завжди відставав би.
enum LoanStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  HANDED_OVER
  RETURNED
  LOST
  /// Stage 10 (T3): власник записав наявну позику, чекає відповіді позичальника (10e).
  PENDING_CONFIRMATION
  /// Stage 10 (T3): позичальник відмовився від запису власника (10e).
  DECLINED
}

enum BorrowerKind {
  REGISTERED
  GUEST
}

enum LoanOrigin {
  REQUESTED
  RECORDED_EXISTING
  RECORDED_GUEST
}

/// Stage 10 (T4): типи подій `LoanEvent`. Значення `LINK_*` додасть крок 10i.
/// `LOSS_CLOSED` (10f.3, T7b): власник закрив питання втрати гостьової позики без факту повернення
/// чи знахідки — не взаємовиключне з `RECOVERED` (§6.11.1, Q3c).
enum LoanEventType {
  RECORD_PROPOSED
  RECORD_AMENDED
  RECORD_CONFIRMED
  RECORD_DECLINED
  RECORD_WITHDRAWN
  GUEST_LOAN_RECORDED
  LOAN_RETURNED
  LOAN_LOST
  RECOVERED
  LOSS_CLOSED
  /// Stage 10 (10i.1): власник створив запит гостьового підтвердження після фізичної передачі.
  GUEST_CONFIRMATION_REQUESTED
  /// Stage 10 (10i.1): власник скасував помилкову передачу (книжка фізично в нього).
  GUEST_HANDOVER_CANCELLED
  /// Stage 10 (10i.1): власник залишив позику активною як запис лише зі слів власника.
  GUEST_LOAN_OWNER_RECORDED
  /// Stage 10 (10i.2): гість після доведеного контролю email відповів «Отримав книжку».
  GUEST_LOAN_RECEIVED
  /// Stage 10 (10i.2): гість після доведеного контролю email відповів «Не отримував».
  GUEST_LOAN_DENIED
}

/// Stage 10 (D1): контакт-гість у межах бібліотеки одного власника. Не `User`, не спільний
/// каталог. `alias` — єдине PII; email не зберігається (T6). Функцію заблоковано D2
/// (release blocker): таблиця існує, але 10a її не заповнює.
model ExternalBorrower {
  id                   String    @id @default(cuid())
  ownerId              String
  alias                String
  /// D2: коли власник заявив «я повідомив(-ла) гостя». НЕ згода і НЕ правова підстава.
  ownerInformedAt      DateTime?
  /// D3: NULL — є активна позика; інакше момент видалення контакту.
  retainUntil          DateTime?
  createdAt            DateTime  @default(now())
  /// Stage 10 (10i.1, §0.13): нікнейм, email і час перевірки контролю email, які ПІДТВЕРДИВ гість.
  /// Приватні, лише для власника; alias власника вони не замінюють. Усі три — NULL або всі не-NULL
  /// (CHECK `external_borrower_guest_identity_all_or_none`). Видаляються разом із контактом (D3).
  guestNickname        String?
  guestEmail           String?
  guestEmailVerifiedAt DateTime?

  owner              User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  loans              Loan[]                  @relation("LoanBorrowerContact")
  heldCopies         Copy[]                  @relation("CopyHeldByContact")
  guestConfirmations GuestLoanConfirmation[]

  @@index([ownerId])
  @@index([retainUntil])
}

/// Stage 10 (10i.1): технічний стан запиту гостьового підтвердження конкретної позики. Окремо від
/// `LoanStatus`: заперечення гостя нового статусу позики не створює (Q27).
enum GuestLoanConfirmationStatus {
  OPEN
  DENIED
  RECEIVED
  CANCELLED
  OWNER_RECORDED
}

/// Stage 10 (10i.1): запит гостьового підтвердження, пов'язаний з конкретними `Loan` і `ExternalBorrower`.
/// Старі ручні гостьові позики (10f.3) рядка не мають. `externalBorrowerId` → NULL після видалення
/// контакту (D3/ручний DELETE); сам рядок і `Loan` лишаються. Порядок локів: ExternalBorrower → Copy →
/// Loan → GuestLoanConfirmation.
model GuestLoanConfirmation {
  id                 String                      @id @default(cuid())
  loanId             String                      @unique
  externalBorrowerId String?
  status             GuestLoanConfirmationStatus @default(OPEN)
  createdAt          DateTime                    @default(now())
  /// NULL, поки статус OPEN чи DENIED; інакше момент завершення (CHECK `guest_loan_confirmation_resolved_at`).
  resolvedAt         DateTime?

  /// Stage 10 (10i.2): ПОТОЧНЕ посилання — лише SHA-256 токена (сирий токен ніде не зберігається).
  /// Повторна видача перезаписує геш (старе посилання гасне негайно); відповідь/дія власника обнуляє все.
  /// Триплет `link*` — усе або нічого; посилання можливе лише для статусу OPEN.
  linkTokenHash String?   @unique
  linkIssuedAt  DateTime?
  /// linkIssuedAt + 7 днів (серверний час видачі, Q24).
  linkExpiresAt DateTime?

  /// Виклик перевірки email: HMAC(підтвердження, адреса гостя, нікнейм) — без відкритих значень.
  challengeMac        String?
  /// HMAC одноразового шестизначного коду, прив'язаний до challengeMac; NULL після успіху/вичерпання.
  codeHash            String?
  codeExpiresAt       DateTime?
  /// Незалежний випадковий ідентифікатор КОЖНОЇ видачі коду (не залежить від значення коду): за ним гасять код
  /// після збою відправки. NULL ⇔ codeHash NULL (CHECK `guest_confirmation_code_nonce`).
  codeNonce           String?
  /// Хибні спроби для ПОТОЧНОГО коду (гасне код при вичерпанні).
  codeAttempts        Int       @default(0)
  /// Хибні спроби за все життя ПОТОЧНОГО посилання (стеля проти перебору між кодами).
  codeFailedTotal     Int       @default(0)
  /// Скільки кодів надіслано у вікні `codeWindowStartedAt` (ліміт на посилання).
  codeSentCount       Int       @default(0)
  codeWindowStartedAt DateTime?
  /// Доказ контролю email: SHA-256 випадкового значення, віддається лише гостю, що ввів правильний код.
  proofHash           String?
  proofExpiresAt      DateTime?
  /// Момент успішної перевірки коду; потрапляє в `ExternalBorrower.guestEmailVerifiedAt` при відповіді.
  verifiedAt          DateTime?

  loan             Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  externalBorrower ExternalBorrower? @relation(fields: [externalBorrowerId], references: [id], onDelete: SetNull)

  @@index([externalBorrowerId])
}

/// Stage 10 (T4): append-only audit trail. `payload` — strict-схема на тип, без alias/email.
/// Рядок `Loan` не можна видалити, поки є події (RESTRICT).
model LoanEvent {
  id          String        @id @default(cuid())
  loanId      String
  type        LoanEventType
  actorId     String?
  occurredAt  DateTime      @default(now())
  /// Фактична дата події (напр. дата знахідки), якщо відрізняється від `occurredAt`.
  effectiveAt DateTime?
  payload     Json          @default("{}")

  loan  Loan  @relation(fields: [loanId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([loanId, occurredAt])
}

// ---------------------------------------------------------------------------
// §4.7 Оцінки
// ---------------------------------------------------------------------------

/// §3: відгуки на твір, щоб не розповзалися по виданнях.
model Review {
  id        String   @id @default(cuid())
  workId    String
  userId    String
  /// 1..5
  rating    Int
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// R5 (docs/plan/stage-7.md): мерж двох `Work` не має права втратити рецензію.
  /// Якщо після переносу на канонічний твір у людини їх стало дві, активною
  /// лишається новіша за `updatedAt`, а друга архівується — рядок нікуди не
  /// зникає, лише перестає бути «тим самим відгуком».
  archivedAt DateTime?

  /// `Work`, який зливали, коли цей відгук заархівували.
  ///
  /// Id вихідного твору однозначно ідентифікує операцію мержу саме тому, що
  /// `MergeService` вимагає канонічного source: твір може побувати вихідним
  /// рівно один раз, після чого його власний `mergedIntoId` уже проставлено й
  /// другий мерж із нього відхиляється (`WORK_MERGE_SOURCE_ALREADY_MERGED`).
  /// Тому окрема таблиця-журнал мержів тут не потрібна.
  archivedByMergeSourceId String?

  work                  Work  @relation("ReviewWork", fields: [workId], references: [id], onDelete: Cascade)
  archivedByMergeSource Work? @relation("ReviewArchivedByMerge", fields: [archivedByMergeSourceId], references: [id])
  user                  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// §4.7 «один користувач — один відгук на твір» живе не тут, а частковим
  /// унікальним індексом `one_active_review_per_work_user` (`WHERE "archivedAt"
  /// IS NULL`), дописаним у міграції руками: Prisma Schema Language часткових
  /// індексів не виражає. Тут його немає навмисно — інакше архівна копія й
  /// активна рецензія тієї самої людини не могли б співіснувати після мержу.
  @@index([workId])
}

/// §3: оцінка якості перекладу висить на `Translation`, а НЕ на `Edition`. Один
/// переклад виходить у кількох видавництвах — на виданні ранг розмазався б.
model TranslationRating {
  id            String   @id @default(cuid())
  translationId String
  userId        String
  /// 1..5 — якість перекладу, не твору
  rating        Int
  text          String?
  createdAt     DateTime @default(now())

  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([translationId, userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

/// Stage 10 (10j, R-1): особистий статус читання. Відсутність рядка = «статус не встановлювали».
enum ReadingStatus {
  NOT_READ
  READING
  READ
}

/// Stage 10 (10j, T11, M7): приватний статус читання зареєстрованого користувача щодо `Work`
/// (R-2). Жодних зв'язків з `Copy`/`Loan`/`ExternalBorrower` — статус ставить лише сам користувач
/// (R-3). Явний `NOT_READ` = свідоме скидання; його `updatedAt` бере участь у merge (Q19).
/// `updatedAt` — не `@updatedAt`: його ставить лише `ReadingStatusService` сирим SQL (`clock_timestamp()` після
/// блокування рядка, тож час іде в порядку фактичних змін); повторний PUT і перенос при merge його не чіпають.
model WorkReadingStatus {
  id        String        @id @default(cuid())
  userId    String
  workId    String
  status    ReadingStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Restrict)

  @@unique([userId, workId])
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
}

// ---------------------------------------------------------------------------
// §4.8 Сповіщення
// ---------------------------------------------------------------------------

/// §4.8: розділення Notification / NotificationDelivery не декоративне — одна подія
/// йде в кілька каналів, і кожен має власний статус та лічильник спроб.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// loanId, copyId, actorId тощо
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  /// Ключ ідемпотентності щоденного дайджесту (§7.5): `<userId>:<type>:<YYYY-MM-DD>`.
  ///
  /// Доповнення до §4.8, і вимушене. Дайджест мусить бути ідемпотентним між
  /// ПРОЦЕСАМИ: прапорець у пам'яті воркера не заважає двом інстансам API
  /// одночасно прочитати «сьогодні ще не надсилали» й створити дублікати.
  /// Унікальний індекс перекладає це рішення на базу — єдиного місця, яке бачать
  /// обидва процеси. `null` для всіх негайних подій §7.5: у Postgres унікальність
  /// не поширюється на NULL, тож вони не заважають одна одній.
  digestKey String? @unique

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
}

/// §7.3: черга доставки — таблиця, не Redis/BullMQ. Воркер забирає рядки зі
/// `status = PENDING AND nextAttemptAt <= now()`.
model NotificationDelivery {
  id             String         @id @default(cuid())
  notificationId String
  channel        Channel
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now())
  sentAt         DateTime?
  error          String?

  /// Хто саме зараз тримає цей рядок. Доповнення до §4.8 — і без нього черга
  /// некоректна.
  ///
  /// «Захопив рядок» і «маю право записати результат» — різні твердження.
  /// Воркер, чия оренда протухла (процес завис, GC, повільна мережа), не має
  /// права затерти результат того, хто підхопив рядок після нього: інакше свіжий
  /// `SENT` перетворюється на старий `PENDING`, і лист іде втретє. Тому кожне
  /// захоплення виписує НОВИЙ токен, а фінальний запис іде з умовою
  /// `WHERE leaseToken = <мій>` — класичний fencing token.
  leaseToken String?
  /// Доки діє оренда. Після цього моменту рядок може забрати будь-хто.
  leaseUntil DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

/// §7.6: матриця «тип події × канал».
model NotificationPreference {
  userId  String
  type    NotificationType
  channel Channel
  enabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
}

/// §7.4: прив'язка Telegram через deep link із TTL 10 хвилин.
model TelegramLinkToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

/// `LOAN_CANCELLED` — свідоме доповнення до §4.8. §5.1 для переходу
/// `APPROVED → CANCELLED` вимагає «сповіщення другій стороні», але типу під нього
/// в переліку §4.8 немає. Переприсвоїти `LOAN_REJECTED` не можна: «вам відмовили»
/// і «домовленість скасовано» — різні події, і на етапі 3 різниця поїде в текст
/// листа та повідомлення в Telegram.
enum NotificationType {
  LOAN_REQUESTED
  LOAN_APPROVED
  LOAN_REJECTED
  LOAN_CANCELLED
  LOAN_HANDED_OVER
  LOAN_RETURNED
  LOAN_DUE_SOON
  LOAN_OVERDUE
  FRIEND_REQUESTED
  FRIEND_ACCEPTED
  /// Stage 10 (10e): життєвий цикл запису наявної позики між друзями.
  LOAN_RECORD_PROPOSED
  LOAN_RECORD_CONFIRMED
  LOAN_RECORD_DECLINED
  LOAN_RECORD_WITHDRAWN
  LOAN_RECORD_AMENDED
  /// Stage 10 (10i.3): відповідь гостя на запит підтвердження. Лише in-app (технічна пропозиція).
  GUEST_LOAN_RECEIVED
  GUEST_LOAN_DENIED
}

enum Channel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Stage 8a — product analytics (docs/plan/stage-8-activation.md, §2)
// ---------------------------------------------------------------------------

/// Один додатковий запис поруч із вже наявними доменними мутаціями (§1, §3
/// stage-8-activation.md). Навмисно без FK на Copy/Loan/Friendship/Edition/Work —
/// подія має пережити hard delete цих сутностей. `type` — String, не Prisma-enum:
/// закритий набір значень і Zod-схеми `properties` живуть у apps/api/src/analytics/**
/// (§2.5), а не тут.
model ProductEvent {
  id            String   @id @default(cuid())
  type          String
  properties    Json
  schemaVersion Int      @default(1)
  /// Opaque/pseudonymous, §2.2 — жодного domain ID у відкритому вигляді.
  dedupeKey     String   @unique
  occurredAt    DateTime @default(now())

  /// §2.1: навмисне відхилення від конвенції — SetNull, не Cascade. Подія
  /// переживає видалення User; агрегати не мають ставати неправильними, коли
  /// один користувач із когорти видалить акаунт.
  subjectUserId String?
  subjectUser   User?   @relation(fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([subjectUserId, type])
}

// ---------------------------------------------------------------------------
// Stage 8f-1: CSV library import drafts (docs/plan/stage-8-inventory.md, R5/R6, §5)
// ---------------------------------------------------------------------------

/// One uploaded file per owner and content. The raw file is never stored: only
/// the opaque `sourceHash`, status, counts and timestamps, plus per-row payload
/// in `LibraryImportRow` while the import is a draft.
model LibraryImport {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// R6: SHA-256 (hex) of the received UTF-8 bytes minus one leading BOM.
  /// A pseudonymous equality key, not anonymization.
  sourceHash String
  status     LibraryImportStatus @default(DRAFT)

  rowCount         Int
  copyCount        Int
  /// Idempotency summary of a committed import — written by the commit (8g).
  createdCopyCount Int?

  /// Draft TTL (24 h). Only meaningful while `status = DRAFT`; expiry is lazy.
  expiresAt   DateTime
  committedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rows LibraryImportRow[]

  @@unique([ownerId, sourceHash])
  @@index([ownerId, status])
  @@index([expiresAt])
}

enum LibraryImportStatus {
  DRAFT
  EXPIRED
  COMMITTED
}

model LibraryImportRow {
  importId  String
  import    LibraryImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber Int
  status    LibraryImportRowStatus

  /// `libraryImportRowPayloadSchema` (packages/shared), validated on every
  /// write and read. Holds the private `note`, so it is deleted on expiry.
  payload Json

  @@id([importId, rowNumber])
}

enum LibraryImportRowStatus {
  READY_EXISTING_EDITION
  READY_CREATE_CHAIN
  NEEDS_REVIEW
  INVALID
  SKIPPED
}

// ---------------------------------------------------------------------------
// Stage 9: invitations (docs/plan/stage-9-network-activation.md, §6, §9)
// ---------------------------------------------------------------------------

enum InvitationKind {
  LINK
  EMAIL
}

/// A capability to ask for a friendship. Only the SHA-256 of the token is stored
/// (as for sessions and mail tokens). A raw e-mail address is never stored:
/// `recipientEmailHash` exists only for anti-abuse limits.
model Invitation {
  id        String         @id @default(cuid())
  inviterId String
  inviter   User           @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  kind      InvitationKind

  tokenHash          String  @unique
  recipientEmailHash String?
  maxUses            Int

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  acceptances InvitationAcceptance[]

  @@index([inviterId, createdAt])
  @@index([recipientEmailHash, createdAt])
}

/// One row per (invitation, person). The unique key makes a repeat open
/// idempotent; the number of rows is the invitation's use count.
model InvitationAcceptance {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([invitationId, userId])
  @@index([userId])
}
