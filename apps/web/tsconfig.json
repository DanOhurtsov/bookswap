{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "types": ["node", "react", "react-dom", "jest"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // TD-01: eslint-fixtures/feature-composition/ carries its own eslint.config.mjs and imports
  // fake `@/features/fixture-feature-*` paths on purpose, to exercise no-restricted-imports
  // pattern matching (which never resolves modules) without a real second product feature.
  // Those paths don't exist under the real `@/*` -> `./*` alias, so tsc must not see them.
  "exclude": ["node_modules", ".next", "eslint-fixtures/feature-composition", "**/__td01-*"]
}
