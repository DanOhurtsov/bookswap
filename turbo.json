{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    // Prisma 7 більше не запускає `generate` як побічний ефект `migrate dev`, тож
    // генерація клієнта — явний крок. Усе, що читає згенерований код, залежить
    // від нього; пакети без цього скрипта turbo просто пропускає.
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "env": ["DIRECT_DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    // Stage 8f-1: the API contract test reads the web app's CSV import template
    // with the API parser (library-import-template.spec.ts). The asset lives
    // outside this package, so it is added to the default inputs explicitly —
    // otherwise editing only the template would replay a stale cached result.
    "@bookswap/api#test": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/library-import-template.csv",
        "$TURBO_ROOT$/apps/web/public/library-import-template.xlsx"
      ],
      "outputs": []
    },
    // Потребує запущеної PostgreSQL, тож кешувати нічого: результат залежить від
    // стану бази, а не лише від вмісту репозиторію.
    "test:db": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL", "DIRECT_DATABASE_URL", "TEST_DATABASE_URL"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "env": ["PORT", "WEB_ORIGIN", "NEXT_PUBLIC_API_URL", "DATABASE_URL", "DIRECT_DATABASE_URL"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
