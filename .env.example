# §12.2: .env — ОДИН, у корені репозиторію.
# Скопіюй цей файл у `.env` і за потреби підправ значення.

NODE_ENV=development

# --- apps/api ---------------------------------------------------------------
# §13.1: порт застосунку через env, не хардкодом.
PORT=3001

# Адреса фронтенду. Використовується двічі: як дозволений origin для CORS і як
# основа посилань у листах (підтвердження пошти, скидання пароля) — вони ведуть
# на фронт, а не на API.
WEB_ORIGIN=http://localhost:3000

# Терміни життя сесій і одноразових токенів навмисно НЕ в оточенні: вони однакові
# в усіх середовищах і живуть константами в apps/api/src/auth/auth.constants.ts.
# Єдине, що залежить від середовища, — атрибут Secure на кукі; він виводиться
# з NODE_ENV.
#
# З тієї ж причини поза оточенням лишаються числа §7.3 — тик диспетчера (30 с),
# ліміт спроб (5) і backoff. Вони в apps/api/src/notifications/notifications.constants.ts.

# §11, R2: rate limiting на створення Work/Translation/Edition — антиспам
# спільного каталогу. Сховище лічильника — в пам'яті процесу: не переживає
# рестарт і не ділиться між інстансами API (детальніше — README, розділ
# «Каталог і бібліотека»). CATALOG_WRITE_RATE_WINDOW_MS — вікно в мілісекундах.
CATALOG_WRITE_RATE_LIMIT=30
CATALOG_WRITE_RATE_WINDOW_MS=3600000

# docs/plan/stage-7.md, етап 7b: автозаповнення форми за ISBN.
# CATALOG_LOOKUP_TIMEOUT_MS       — скільки чекати на зовнішній провайдер, інакше 504.
# CATALOG_LOOKUP_CACHE_TTL_MS     — R3: TTL кешу `ExternalBookLookup`; попадання
#                                    в кеш не робить зовнішнього виклику.
# CATALOG_LOOKUP_NEGATIVE_CACHE_TTL_MS — короткий TTL для ISBN, яких не знає жоден провайдер.
CATALOG_LOOKUP_TIMEOUT_MS=5000
CATALOG_LOOKUP_CACHE_TTL_MS=2592000000
CATALOG_LOOKUP_NEGATIVE_CACHE_TTL_MS=86400000

# Провайдери викликаються послідовно: Open Library → Google Books → ISBNdb.
# Google Books працює і без ключа, але ключ дає окрему квоту проєкту.
GOOGLE_BOOKS_API_KEY=
# ISBNdb — опційний платний fallback; без ключа адаптер не робить HTTP-запитів.
ISBNDB_API_KEY=
ISBNDB_API_URL=https://api2.isbndb.com

# §11, R2: rate limiting на GET /catalog/lookup — окремий бакет від
# CATALOG_WRITE_RATE_LIMIT (детальніше — common/rate-limit.config.ts). Кожен
# запит іде до зовнішнього провайдера на cache miss, а попадання в кеш (R3)
# рахується цим лімітом так само, як і miss.
CATALOG_LOOKUP_RATE_LIMIT=20
CATALOG_LOOKUP_RATE_WINDOW_MS=60000

# --- Пошта (§7.2) -----------------------------------------------------------
# dev    — нічого не надсилає, друкує лист у лог і тримає в пам'яті. Досить, щоб
#          пройти підтвердження пошти локально; у production ЗАБОРОНЕНО (у тілі
#          листа — одноразовий токен, а лог його не захищає).
# resend — справжня відправка через https://api.resend.com. Вимагає обидві змінні нижче.
EMAIL_PROVIDER=dev
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=BookSwap <bookswap@example.com>

# --- Telegram-бот (§7.4) ----------------------------------------------------
# Опційний. Без токена канал TELEGRAM неактивний НЕЗАЛЕЖНО від NODE_ENV:
# channelsFor() дивиться на TelegramConfig.configured і без токена не створює
# жодної TELEGRAM-доставки, а кнопка «Підключити» в обох середовищах віддає
# 503 TELEGRAM_NOT_CONFIGURED. Різниця лише в тому, який транспорт піднятий у
# контейнері (реального потоку сповіщень через нього однаково не буває):
#   - поза production   — FakeTelegramApi: існує лише щоб DI зібрався без
#                          спеціального випадку на dev/тести, і щоб сам
#                          транспорт можна було перевірити ізольовано. У лог
#                          іде лише факт і форма повідомлення (кількість
#                          кнопок), НЕ chat_id і НЕ текст — це чуже приватне
#                          листування. Сам вміст доступний лише через outbox
#                          у пам'яті процесу — і лише тому, хто звернеться до
#                          нього напряму, в обхід channelsFor.
#   - у production       — UnavailableTelegramApi: кожна спроба ним
#                          скористатися дає явну помилку в
#                          NotificationDelivery.error, а не тихий "успіх".
#
# Три змінні задаються КОМПЛЕКТОМ — застосунок не стартує з частиною. Токен без
# імені бота не дає зібрати deep link `t.me/<bot>?start=<token>`, а токен без
# секрету лишає POST /webhooks/telegram — єдиний маршрут без сесії — відкритим.
#
# TELEGRAM_WEBHOOK_SECRET — те саме значення, що передається в `secret_token`
# методу setWebhook; Telegram повертає його заголовком X-Telegram-Bot-Api-Secret-Token
# на кожному запиті. Дозволені символи: A-Z a-z 0-9 _ - ; від 16 символів.
# Згенерувати: openssl rand -hex 32
#
# Локально вебхук потребує публічної адреси (тунель), інакше Telegram не достукається:
#   curl -F url=https://<публічний-хост>/api/v1/webhooks/telegram \
#        -F secret_token=$TELEGRAM_WEBHOOK_SECRET \
#        https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_BOT_USERNAME=bookswap_bot
# TELEGRAM_WEBHOOK_SECRET=

# --- apps/web ---------------------------------------------------------------
# У клієнтський бандл Next потрапляють ЛИШЕ змінні з префіксом NEXT_PUBLIC_.
# Нічого секретного під цим префіксом бути не може.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- PostgreSQL (docker-compose.yml) ----------------------------------------
# Креденшели збігаються з docker-compose.yml. Обидві змінні ОБОВ'ЯЗКОВІ: API падає
# на старті без них, а `prisma generate` не запуститься без DIRECT_DATABASE_URL.
#
# §4.1: DIRECT_DATABASE_URL обов'язковий навіть коли локально дублює DATABASE_URL —
# у проді DATABASE_URL піде через PgBouncer, а міграції беруть advisory lock,
# який не переживає transaction pooling.
#
# Розподіл ролей у Prisma 7 (поля `directUrl` у datasource більше немає):
#   DATABASE_URL        — рантайм-клієнт через драйвер-адаптер @prisma/adapter-pg
#   DIRECT_DATABASE_URL — Prisma CLI: міграції, introspection, seed
DATABASE_URL=postgresql://bookswap:dev@localhost:5432/bookswap?schema=public
DIRECT_DATABASE_URL=postgresql://bookswap:dev@localhost:5432/bookswap?schema=public

# Окрема база під `pnpm test:db`. Тести дропають і створюють її заново на кожному
# прогоні, тож дані dev-бази вони не чіпають. Достатньо, щоб контейнер із
# docker-compose.yml був піднятий — саму базу створює globalSetup.
#
# УВАГА: назва мусить закінчуватися на `_test`, лежати на localhost і НЕ збігатися
# з DATABASE_URL / DIRECT_DATABASE_URL. Інакше `pnpm test:db` відмовиться стартувати
# (fail-closed перевірка в apps/api/test/db/guard.ts) — це захист від DROP DATABASE
# по чужій базі.
TEST_DATABASE_URL=postgresql://bookswap:dev@localhost:5432/bookswap_test?schema=public
